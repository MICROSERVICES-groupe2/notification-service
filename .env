PORT=8087
NODE_ENV=development

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_GROUP_ID=notifications-group

# SMTP (Dev Local) - Utilise Mailhog par défaut sur le port 1025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=

# SendGrid (Email en Production)
SENDGRID_API_KEY=SG.your_sendgrid_api_key_placeholder

# Twilio (SMS en Production)
TWILIO_ACCOUNT_SID=ACyour_twilio_account_sid_placeholder
TWILIO_AUTH_TOKEN=your_twilio_auth_token_placeholder
TWILIO_PHONE=+1234567890

# Firebase (Push notifications)
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_private_key_placeholder\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=your_firebase_client_email
